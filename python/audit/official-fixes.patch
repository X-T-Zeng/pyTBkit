 function f1 = Fermi_1(E_minus_mu, T)
 % first derivative of Fermi-Dirac distribution 
-k_B = 8.6173324e-5; % eV/K
+if ~isscalar(T) || ~isfinite(T) || T <= 0
+    error('TBkit:InvalidTemperature','Fermi energy derivatives require finite T>0; at T=0 they are distributions.');
+end
+k_B = 8.617333262145e-5; % eV/K
 beta = 1/(T * k_B);
 
-f0 = Fermi_0(E_minus_mu, T);
-f1  = -beta .* f0 .* (1 - f0);
-end
\ No newline at end of file
+x = E_minus_mu * beta;
+z = exp(-abs(x));
+variance = z./(1+z).^2;
+f1 = -beta .* variance;
+end
