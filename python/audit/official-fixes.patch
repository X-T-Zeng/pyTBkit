diff --git a/src/functions_transport/Fermi_0.m b/src/functions_transport/Fermi_0.m
index d6d1cc5..c4b71f2 100644
--- a/src/functions_transport/Fermi_0.m
+++ b/src/functions_transport/Fermi_0.m
@@ -1,12 +1,17 @@
 function f0 = Fermi_0(E_minus_mu, T)
-% Fermi-Dirac distribution
-k_B = 8.6173324e-5; % eV/K
-beta = 1/(T * k_B);
-
-exp_power = E_minus_mu * beta;
-
-mask = exp_power < 50;
-
-f0 = zeros(size(E_minus_mu));
-f0(mask) = 1./(exp(exp_power(mask)) + 1);
-end
\ No newline at end of file
+%FERMI_0 Stable Fermi occupation, energies eV and temperature Kelvin.
+if ~isscalar(T) || ~isfinite(T) || T < 0
+    error('TBkit:InvalidTemperature','Temperature must be finite and nonnegative.');
+end
+if T == 0
+    f0 = double(E_minus_mu < 0) + 0.5*double(E_minus_mu == 0);
+    return;
+end
+k_B = 8.617333262145e-5;
+x = E_minus_mu/(T*k_B);
+% exp(-abs(x)) avoids overflow in either energy tail.
+z = exp(-abs(x));
+f0 = z./(1+z);
+negative = x < 0;
+f0(negative) = 1./(1+z(negative));
+end
